# Filesystem path to the SQLite database. Created on first run; `src/db/migrate.ts` migrates and
# seeds it idempotently at startup. On the VPS this is set in /etc/urlopy/env by install.sh.
DATABASE_PATH=./urlopy.db

# The origin the browser actually sees, e.g. https://urlopy.internal. Behind nginx the Node
# process cannot observe the scheme, so this is what drives the session cookie's `Secure` flag.
# Leave it on http:// for local work or the cookie will be set and never sent back.
PUBLIC_ORIGIN=http://localhost:4321

# The sub-path the app is mounted under, when it shares a hostname with other applications
# (e.g. /urlopy on a server that also serves /wrifboard and /metabase). Leave unset when Urlopy
# owns the root. BUILD-TIME, like PUBLIC_ORIGIN and more strictly: Astro bakes it into every asset
# URL, every redirect and the session cookie's Path, so changing it needs a rebuild and a matching
# nginx location. See deploy/nginx/urlopy-location.conf.
# PUBLIC_BASE_PATH=/urlopy

# E2E tests (Playwright) — credentials for the test user account
E2E_USER_EMAIL=oliwa.bartosz@gmail.com
E2E_USER_PASSWORD=###

# Sentry — source map upload token (build-time only, not a runtime secret).
# Also optionally read by `npm run digest` to list new Sentry issues; without it
# the digest's Sentry section is simply skipped ("niedostępne").
SENTRY_AUTH_TOKEN=###
# Sentry — DSN for error reporting. Unreachable from an offline VPS; leave unset there.
SENTRY_DSN=###

# SUPER-ADMIN CREDENTIALS — consumed by `npm run seed:admin` (one-time-per-environment, runs in Node).
# Creates the hidden technical admin (role: moderator, is_system=true) as a `users` row carrying a
# local scrypt hash plus the `employees` row that points at it. Re-running is a no-op.
# ADMIN_PASSWORD must be at least 8 characters.
ADMIN_LOGIN=admin@your-email.com
ADMIN_PASSWORD=admin-password-goes-here
