# Nightly SQLite snapshot.
#
# Template: install.sh substitutes @PLACEHOLDERS@ (none today — kept uniform with the two units
# beside it) and writes the result to /etc/systemd/system/urlopy-backup.timer.
[Unit]
Description=Urlopy — nightly SQLite backup
Documentation=file://@APP_ROOT@/current/INSTALL.md

[Timer]
# 03:15 local time. Off the hour on purpose: an offline box still runs logrotate and friends at
# the top of the hour, and a backup that contends with them for the disk is slower for no reason.
OnCalendar=*-*-* 03:15:00
# The VPS may be powered off overnight. Without this, a missed window is simply skipped and the
# install can go weeks with no backup while `systemctl list-timers` looks perfectly healthy.
Persistent=yes
# Spread the actual start over five minutes so a fleet of these does not stampede shared storage.
RandomizedDelaySec=5m

[Install]
WantedBy=timers.target
