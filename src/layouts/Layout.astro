---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import { Toaster } from "@/components/ui/sonner";
import { getMissingConfigs } from "@/lib/config-status";
import { withBase } from "@/lib/base-path";

interface Props {
  title?: string;
}

const { title = "Nieobecności" } = Astro.props;

// Async since the SQLite port: the banner now reports on the install's own state (database
// reachable, technical admin seeded) rather than on the presence of two environment variables.
const missingConfigs = await getMissingConfigs();
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={withBase("/icon.svg")} />
    <title>{title}</title>
  </head>
  <body>
    {
      missingConfigs.map((cfg) => (
        <Banner variant="error">
          <strong>Uwaga:</strong> {cfg.message}
          {cfg.docsUrl && (
            <>
              {" "}
              <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
                {cfg.docsLabel ?? "Dokumentacja"}
              </a>
              .
            </>
          )}
        </Banner>
      ))
    }
    <slot />
    <Toaster client:load />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
