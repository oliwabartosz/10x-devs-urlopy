---
import Layout from "@/layouts/Layout.astro";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      emoji: "✅",
      heading: "Registration successful",
      description: "Your account has been created. You can now sign in.",
      linkText: "Go to sign in",
    }
  : {
      emoji: "📧",
      heading: "Check your email",
      description: "We've sent a confirmation link to your email address. Click it to activate your account.",
      linkText: "Back to sign in",
    };
---

<Layout title={content.heading}>
  <div class="flex min-h-screen items-center justify-center bg-slate-50 p-4">
    <div class="w-full max-w-md">
      <div
        class="overflow-hidden rounded-2xl border border-slate-100 bg-white p-8 text-center shadow-xl shadow-slate-200"
      >
        <div class="mb-4 text-5xl">{content.emoji}</div>
        <h1 class="mb-3 text-2xl font-bold text-slate-900">{content.heading}</h1>
        <p class="mb-6 text-slate-500">{content.description}</p>
        <a href="/" class="text-sm font-semibold text-[#072143] transition-colors hover:text-[#c5ac75]">
          {content.linkText}
        </a>
      </div>
    </div>
  </div>
</Layout>
