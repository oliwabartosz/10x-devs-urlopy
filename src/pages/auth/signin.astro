---
import Layout from "@/layouts/Layout.astro";
import LoginCardForm from "@/components/auth/LoginCardForm";
import { CalendarCheck } from "lucide-react";

// Kept as a route so bookmarks keep working; `/` is the canonical login surface and
// this page deliberately renders the same shell and form.
const error = Astro.url.searchParams.get("error");
---

<Layout title="Nieobecności — Logowanie">
  <div class="bg-surface flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-md">
      <div class="mb-10 text-center">
        <div
          class="bg-primary mb-4 inline-flex size-20 items-center justify-center rounded-2xl shadow-lg shadow-slate-200"
        >
          <CalendarCheck className="size-10 text-white" />
        </div>
        <h1 class="text-primary text-2xl font-bold">Nieobecności</h1>
        <p class="text-muted-foreground mt-2">Zaloguj się, aby uzyskać dostęp do panelu</p>
      </div>

      <div class="border-line overflow-hidden rounded-2xl border bg-white shadow-xl shadow-slate-200">
        <div class="p-8">
          <LoginCardForm serverError={error} client:load />
        </div>
        <div class="border-line bg-surface border-t px-8 py-4">
          <p class="text-muted-foreground text-center text-xs">Logowanie za pomocą konta służbowego.</p>
        </div>
      </div>

      <p class="text-muted-foreground mt-8 text-center text-xs">© 2026 Nieobecności. Wszystkie prawa zastrzeżone.</p>
    </div>
  </div>
</Layout>
