---
interface Props {
  role?: "employee" | "moderator";
}
const { user } = Astro.locals;
const { role } = Astro.props;
---

<div class="bg-primary text-primary-foreground flex h-14 items-center justify-between px-8 text-sm">
  {
    user ? (
      <>
        <div class="flex items-center gap-3">
          <span>{user.email}</span>
          {role === "moderator" && (
            <span class="bg-accent text-accent-foreground rounded-full px-2.5 py-[3px] text-[11px] font-bold tracking-[0.06em] uppercase">
              Moderator
            </span>
          )}
        </div>
        <div class="flex items-center gap-6">
          <a href="/dashboard" class="hover:text-accent transition-colors">
            Dashboard
          </a>
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class="hover:text-accent cursor-pointer transition-colors">
              Sign out
            </button>
          </form>
        </div>
      </>
    ) : (
      <>
        <span>Not signed in</span>
        <div class="flex gap-6">
          <a href="/auth/signin" class="hover:text-accent transition-colors">
            Sign in
          </a>
        </div>
      </>
    )
  }
</div>
