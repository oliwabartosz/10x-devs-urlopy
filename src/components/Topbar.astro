---
import { AccountMenu } from "@/components/account/AccountMenu";
import { withBase } from "@/lib/base-path";

// `role` used to arrive as a prop from dashboard.astro while middleware.ts:31 already computed
// `locals.userRole` on every request and nothing read it. That is exactly the case
// context/foundation/lessons.md was written about: this component already does one
// Astro.locals lookup (`user`), so the related lookup belongs here too — a prop would silently
// drop the moderator badge the first time the bar is mounted on a new page.
const { user, userRole } = Astro.locals;
---

<div class="bg-primary text-primary-foreground flex h-14 items-center justify-between px-8 text-sm">
  {
    user ? (
      <>
        <div class="flex items-center gap-3">
          <AccountMenu client:load email={user.email} />
          {userRole === "moderator" && (
            <span class="bg-accent text-accent-foreground rounded-full px-2.5 py-[3px] text-[11px] font-bold tracking-[0.06em] uppercase">
              Moderator
            </span>
          )}
        </div>
        <div class="flex items-center gap-6">
          <a href={withBase("/dashboard")} class="hover:text-accent transition-colors">
            Dashboard
          </a>
          {/*
            S-17 of the UI overhaul fixed the top-bar labels to English to match the design
            prototype (context/archive/2026-08-07-huge-ui-ux-improvement/plan.md:210-219). This
            one label is Polish by explicit request; `Dashboard`, `Sign in`, and `Not signed in`
            deliberately stay English. The bar is mixed-language on purpose — do not "restore
            consistency" in either direction without checking back.
          */}
          <form method="POST" action={withBase("/api/auth/signout")}>
            <button type="submit" class="hover:text-accent cursor-pointer transition-colors">
              Wyloguj
            </button>
          </form>
        </div>
      </>
    ) : (
      <>
        <span>Not signed in</span>
        <div class="flex gap-6">
          <a href={withBase("/auth/signin")} class="hover:text-accent transition-colors">
            Sign in
          </a>
        </div>
      </>
    )
  }
</div>
