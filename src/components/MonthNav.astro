---
import { RotateCcw } from "lucide-react";

interface Props {
  prevMonthUrl: string;
  nextMonthUrl: string;
  /**
   * Where "back to today" points. Null (or absent) when the browsed month already *is* the
   * current one, and the control is then not rendered at all — an `<a>` cannot be disabled, and
   * the repo's rule for an inapplicable affordance is to unmount it rather than show it inert.
   */
  currentMonthUrl?: string | null;
  year: number;
  month: number;
}

const { prevMonthUrl, nextMonthUrl, currentMonthUrl, year, month } = Astro.props;

const monthLabel = new Intl.DateTimeFormat("pl-PL", {
  month: "long",
  year: "numeric",
}).format(new Date(year, month - 1));

// Fixed-width heading keeps the arrows from shifting between long and short month names.
const navButton =
  "border-line text-primary hover:bg-primary hover:border-primary hover:text-primary-foreground flex size-9 items-center justify-center rounded-[10px] border bg-white text-base transition-colors";
---

<div class="flex items-center gap-4">
  <a href={prevMonthUrl} class:list={navButton} title="Poprzedni miesiąc" aria-label="Poprzedni miesiąc">‹</a>
  <h1 class="text-primary min-w-[220px] text-center text-2xl font-bold capitalize">{monthLabel}</h1>
  <a href={nextMonthUrl} class:list={navButton} title="Następny miesiąc" aria-label="Następny miesiąc">›</a>
  {
    /* Outside the `‹ heading ›` triplet on purpose: the heading's min-width guarantees the arrows
       do not shift between long and short month names, and a control appearing between them
       would undo it. `title` and `aria-label` carry the same string here: the tooltip is the
       visible half, the label the assistive one. Both arrows above pair them too, so all three
       buttons in the row behave alike on hover. (Elsewhere the two can differ deliberately —
       `EmployeeManagementSheet.tsx:163-164` gives `aria-label` the row's employee name and leaves
       `title` generic — but nothing distinguishes these three.) */
    currentMonthUrl && (
      <a
        href={currentMonthUrl}
        class:list={navButton}
        title="Wróć do bieżącego miesiąca"
        aria-label="Wróć do bieżącego miesiąca"
      >
        <RotateCcw className="size-4" />
      </a>
    )
  }
</div>
